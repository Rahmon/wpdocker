{
	"root": true,
	"extends": ["eslint:recommended", "prettier"],
	"parserOptions": {
		"ecmaVersion": 2021,
		"sourceType": "script"
	},
	"env": {
		"es2021": true,
		"node": true,
		"jest": true
	},
	"rules": {
		"camelcase": [
			"error",
			{
				"allow": ["depends_on", "mem_limit", "mem_reservation", "cap_add"]
			}
		],
		"no-alert": "warn",
		"no-console": "off",
		"no-constant-condition": [
			"error",
			{
				"checkLoops": false
			}
		],
		"no-empty": [
			"error",
			{
				"allowEmptyCatch": true
			}
		],
		"no-var": "warn",
		"prefer-const": "error",
		"prefer-destructuring": [
			"error",
			{
				"array": false,
				"object": true
			}
		],
		"prefer-template": "error",
		"yoda": ["error", "never"]
	}
}
