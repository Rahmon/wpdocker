{
	"extends": ["@10up/eslint-config", "prettier"],
	"env": {
		"es6": true,
		"node": true,
		"jest": true
	},
	"rules": {
		"camelcase": [
			"error",
			{
				"allow": ["depends_on", "mem_limit", "mem_reservation", "cap_add"]
			}
		],
		"no-constant-condition": [
			"error",
			{
				"checkLoops": false
			}
		],
		"no-console": "off",
		"no-empty": [
			"error",
			{
				"allowEmptyCatch": true
			}
		],
		"prefer-destructuring": [
			"error",
			{
				"array": false,
				"object": true
			}
		],
		"require-jsdoc": "off",
		"yoda": ["error", "never"]
	}
}
